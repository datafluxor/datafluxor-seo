# Copy to .env and fill in what you need. Everything here is optional:
# the API key and Google client can also be set in the app's Settings page.

# The address people open. Used for Google sign-in and secure cookies.
DFSEO_PUBLIC_URL=http://localhost:8080

# DataFluxor API key for rankings, Google results, keyword data, AI answers and backlinks.
# Free account: https://datafluxor.com/signup?utm_source=github&utm_medium=self-hosted&utm_campaign=datafluxor-seo
DATAFLUXOR_API_KEY=

# Google OAuth client for Search Console (see docs/search-console.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Largest site audit a user may start (pages).
DFSEO_CRAWL_MAX_PAGES=5000

# Allow audits of private network addresses (intranet sites). Off by default.
DFSEO_CRAWL_ALLOW_PRIVATE=false
